+// --region anon:<node>: private anonymous THPs bound to that NUMA node, for host-paged IM, which parks anonymous
+// THPs. One mapping per process, so the kv-session cells read what the session's kv-load wrote.
+static char *map_anon(const std::string &path, uint64_t off, uint64_t len) {
+    static char *base = nullptr;
+    static uint64_t mapped = 0;
+    if (base) {
+        if (off + len > mapped) die("%s: %.2f GiB mapped, need %.2f GiB", path.c_str(), double(mapped) / kGiB,
+                                    double(off + len) / kGiB);
+        return base + off;
+    }
+    char *end;
+    long node = strtol(path.c_str() + 5, &end, 10);
+    if (end == path.c_str() + 5 || *end || node < 0 || node >= 1024) die("%s: expected anon:<numa node>", path.c_str());
+    mapped = off + len;
+    void *p = mmap(nullptr, mapped + kWin, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0);
+    if (p == MAP_FAILED) die("mmap %.2f GiB: %s", double(mapped) / kGiB, strerror(errno));
+    base = reinterpret_cast<char *>((reinterpret_cast<uintptr_t>(p) + kWin - 1) & ~(kWin - 1));
+    unsigned long nodes[1024 / 64] = {};
+    nodes[node / 64] = 1ul << (node % 64);
+    if (madvise(base, mapped, MADV_HUGEPAGE)) die("madvise(MADV_HUGEPAGE): %s", strerror(errno));
+    if (syscall(SYS_mbind, base, mapped, 2 /* MPOL_BIND */, nodes, 1024, 0))
+        die("mbind node %ld: %s", node, strerror(errno));
+    return base + off;
+}
