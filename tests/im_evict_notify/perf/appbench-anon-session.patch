+// Runs the commands read from stdin, one per line, in this process; a line starting with '!' goes to the shell and
+// must succeed. With --region anon:<node>, every cell reads the data the session's kv-load wrote.
+static int cmd_kv_session(Args &a) {
+    a.finish();
+    char line[4096];
+    int rc = 0;
+    while (fgets(line, sizeof line, stdin)) {
+        line[strcspn(line, "\n")] = 0;
+        if (!line[0] || line[0] == '#') continue;
+        fflush(stdout);
+        if (line[0] == '!') {
+            int st = system(line + 1);
+            if (st) die("kv-session: '%s' exited with status %d", line + 1, st);
+            continue;
+        }
+        std::vector<char *> argv{const_cast<char *>("appbench")};
+        for (char *t = strtok(line, " \t"); t; t = strtok(nullptr, " \t")) argv.push_back(t);
+        rc |= run_command(int(argv.size()), argv.data());
+    }
+    return rc;
+}
